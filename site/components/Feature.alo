                        <rect x="3" y="4" width="18" height="16" rx="2" />
                        <path d="M3 9h18M7 13h4M7 16.5h7" />
                    </template>
                    <template else-if="props.feature.icon === 'robot'">
                        <rect x="4" y="8" width="16" height="11" rx="2.5" />
                        <path d="M12 4v4M9 13v1.5M15 13v1.5M2 13v2M22 13v2" />
                    </template>
                    <template else>
