    .feature[data-new] {
        border-color: var(--accent);
        box-shadow: 0 0 0 4px var(--accent-soft);
    }

    .top {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 1rem;
    }

    .icon {
        display: grid;
        place-items: center;
        width: 2.6rem;
        height: 2.6rem;
        border-radius: 12px;
        background: var(--accent-soft);
        color: var(--accent-strong);
    }

    h3 {
        margin-bottom: 0.35rem;
        font-size: 1.1rem;
    }

    p {
        color: var(--muted);
        font-size: 0.97rem;
    }

    .badges {
        display: flex;
        gap: 0.4rem;
