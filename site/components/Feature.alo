        <p>{{ props.feature.text }}</p>
        <template if="props.feature.points">
            <ul class="points">
                <template for="point in props.feature.points">
                    <li>{{ point }}</li>
                </template>
            </ul>
        </template>
        <template if="props.feature.link">
            <a class="more" href="{{ props.feature.link.href }}">{{ props.feature.link.label }} →</a>
