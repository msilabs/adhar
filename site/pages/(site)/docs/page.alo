        counter-reset: step;
    }

    .steps > li {
        position: relative;
        padding: 0 0 2.5rem 3.25rem;
        counter-increment: step;
    }

    .steps > li::before {
        content: counter(step, bengali);
        position: absolute;
        top: 0;
        left: 0;
        display: grid;
        place-items: center;
        width: 2.2rem;
        height: 2.2rem;
        border-radius: 999px;
        background: var(--accent);
        color: var(--on-accent);
        font-weight: 700;
    }

    .steps > li::after {
        content: '';
        position: absolute;
        top: 2.6rem;
        bottom: 0.4rem;
        left: 1.05rem;
        width: 2px;
        background: var(--border);
    }

    .steps > li:last-child::after {
        display: none;
    }

    h2 {
        margin-bottom: 0.75rem;
        font-size: 1.3rem;
    }

