{
    "name": "@msilabs/adhar",
    "version": "1.2.0",
    "description": "Lightweight backend API framework: folder routes, middleware, validation, services and SQLite. Full stack with Alo. Zero dependencies.",
    "license": "MIT",
    "keywords": [
        "api",
        "backend",
        "framework",
        "file-based-routing",
        "sqlite",
        "bangla",
        "zero-dependency"
    ],
    "homepage": "https://msilabs.github.io/adhar/",
    "bugs": {
        "url": "https://github.com/msilabs/adhar/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/msilabs/adhar.git"
    },
    "type": "commonjs",
    "publishConfig": {
        "access": "public"
    },
    "engines": {
        "node": ">=22.13"
    },
    "bin": {
        "adhar": "bin/adhar.js"
    },
    "exports": {
        ".": "./core/app.js",
        "./cli": "./cli/index.js"
    },
    "files": [
        "bin",
        "cli",
        "core",
        "templates"
    ],
    "scripts": {
        "test": "node --test \"test/**/*.test.js\""
    },
    "devDependencies": {
        "@msilabs/alo": "^1.1.0"
    }
}
